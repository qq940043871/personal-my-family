.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 我的视角头部 */
.me-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.me-left { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.me-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 3rpx solid #FF8A65;
  overflow: hidden;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.me-avatar-img { width: 100%; height: 100%; display: block; border-radius: 50%; }
.me-avatar-emoji { font-size: 44rpx; }
.me-col { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.me-name { font-size: 32rpx; font-weight: 800; color: #1A1A1A; }
.me-meta { font-size: 22rpx; color: #8A8178; }
.me-switch {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFD9C7;
  border-radius: 30rpx;
  padding: 10rpx 22rpx;
  flex-shrink: 0;
}
.me-switch:active { background: #FFF3EC; }
.me-switch-icon { font-size: 22rpx; }
.me-switch-text { font-size: 22rpx; font-weight: 600; color: #FF6D3B; }

/* 进度卡 */
.progress-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.progress-track {
  flex: 1;
  height: 14rpx;
  background: #F3EDE5;
  border-radius: 7rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, #FF8A65, #FF6D3B);
  transition: width 0.5s ease;
}
.progress-text {
  font-size: 22rpx;
  color: #FF6D3B;
  font-weight: 700;
  flex-shrink: 0;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; color: #1E293B; }
.card-subtitle { font-size: 24rpx; color: #64748B; }

/* 任务项 */
.task-list { display: flex; flex-direction: column; gap: 12rpx; }
.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #FFF6F0;
  transition: transform 0.15s ease, background 0.2s ease;
}
.task-item:active { transform: scale(0.98); }
.task-item.done { background: #FFEDD5; opacity: 0.8; border-color: #FFEDD5; }
.task-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF6F0;
  border-radius: 16rpx;
  font-size: 40rpx;
  flex-shrink: 0;
}
.task-info { flex: 1; min-width: 0; }
.task-name { font-size: 28rpx; font-weight: 600; color: #1A1A1A; display: block; }
.task-meta { font-size: 22rpx; color: #8A8178; margin-top: 4rpx; display: block; }
.photo-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #14B8A6;
}
.photo-tag-icon { font-size: 22rpx; }
.task-points { font-size: 24rpx; color: #F59E0B; font-weight: 700; flex-shrink: 0; }
.task-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.camera-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF6F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: 2rpx solid #FFEDD5;
}
.camera-btn:active { transform: scale(0.9); background: #FFEDD5; }
.check-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid #F3EDE5;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
}
.check-btn:active { transform: scale(0.9); }
.check-btn.done {
  background: #34D399;
  border-color: #34D399;
  animation: checkPop 0.3s ease;
}

.empty { text-align: center; padding: 60rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { display: block; font-size: 28rpx; color: #94A3B8; margin-top: 12rpx; }

/* ===== 拍照必填提示条 ===== */
.photo-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #EFF6FF, #F5F3FF);
  border: 2rpx solid #C7D2FE;
  border-radius: 18rpx;
  margin-bottom: 18rpx;
}
.photo-tip-icon { font-size: 34rpx; flex-shrink: 0; }
.photo-tip-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.photo-tip-text { font-size: 22rpx; font-weight: 700; color: #3730A3; }
.photo-tip-sub { font-size: 18rpx; color: #6D28D9; }
.photo-tip-count {
  font-size: 20rpx;
  font-weight: 800;
  color: #4F46E5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.85);
  flex-shrink: 0;
}

/* ===== 已完成任务下的照片条 ===== */
/* 缩进 112rpx = 行内 padding 24 + 图标 72 + gap 16，与任务信息左对齐 */
.photo-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 12rpx 112rpx;
  margin-top: -8rpx;
}
.task-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  border: 2rpx solid #E2E8F0;
}
.thumb-empty {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #F1F5F9;
  border: 2rpx dashed #CBD5E1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.thumb-empty-text { font-size: 16rpx; color: #94A3B8; }
.strip-ops { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.strip-btn {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #F1F5F9;
}
.strip-btn:active { transform: scale(0.95); }
.strip-btn-text { font-size: 20rpx; font-weight: 700; color: #475569; white-space: nowrap; }
.strip-btn-danger { background: #FEF2F2; }
.strip-btn-danger .strip-btn-text { color: #EF4444; }
