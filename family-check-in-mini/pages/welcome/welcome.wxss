.page {
  padding: 48rpx 36rpx 60rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ===== 头部 ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 0 40rpx;
}
.hero-emoji { font-size: 88rpx; line-height: 1.2; }
.hero-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1E293B;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #8A8178;
}

/* ===== 身份宫格 ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  justify-content: center;
}
.role-card {
  position: relative;
  width: 208rpx;
  background: #FFFFFF;
  border: 4rpx solid transparent;
  border-radius: 28rpx;
  padding: 26rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease;
}
.role-card:active { transform: scale(0.96); }
.role-card.active {
  background: #FFF3EC;
  box-shadow: 0 6rpx 18rpx rgba(255, 138, 101, 0.25);
}
.role-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FF8A65;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.role-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
}
.role-avatar-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F5EFE8;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.role-avatar-create {
  background: #FFF3EC;
  display: flex;
  align-items: center;
  justify-content: center;
}
.role-plus { font-size: 56rpx; color: #FF8A65; font-weight: 300; }
.role-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}
.role-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #A8A29E;
}

/* ===== 表单 ===== */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.form-label {
  width: 150rpx;
  font-size: 27rpx;
  color: #1E293B;
  font-weight: 500;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
  padding: 10rpx 0;
}
.form-tip {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #A8A29E;
  line-height: 1.5;
}

/* ===== 确认按钮 ===== */
.confirm-btn {
  margin-top: 40rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FF8A65, #FF6D3B);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 101, 0.35);
}
.confirm-btn.disabled { opacity: 0.45; }
.confirm-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.footnote {
  margin-top: 26rpx;
  padding: 0 12rpx;
}
.footnote-text {
  font-size: 22rpx;
  color: #A8A29E;
  line-height: 1.6;
  text-align: center;
  display: block;
}
