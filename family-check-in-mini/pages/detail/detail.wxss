.page {
  padding: 28rpx 32rpx 60rpx;
  background: #FFF6F0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.dh-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid #FF8A65;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #F3F4F6;
}
.dh-avatar-img { width: 100%; height: 100%; display: block; border-radius: 50%; }
.dh-avatar-emoji { font-size: 52rpx; }
.dh-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.dh-name-row { display: flex; align-items: baseline; gap: 12rpx; }
.dh-name { font-size: 40rpx; font-weight: 800; color: #1A1A1A; }
.dh-age { font-size: 22rpx; color: #8A8178; }
.dh-pet { font-size: 24rpx; color: #A88B6A; font-weight: 600; }
.dh-stage-badge {
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}
.dh-stage-text { font-size: 24rpx; font-weight: 800; color: #FFFFFF; }

/* ===== 区块 ===== */
.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.col-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
  display: block;
}
.col-title-wrap { display: flex; align-items: center; gap: 12rpx; }
.col-title-sub {
  font-size: 22rpx;
  font-weight: 700;
  color: #FF8A65;
  background: #FFEDD5;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

/* ===== 任务卡 ===== */
.trial-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.trial-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 20rpx;
  border: 3rpx solid #F3EDE5;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}
.trial-card.done { opacity: 0.78; }
.trial-card:active { transform: scale(0.98); }
.trial-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.trial-name { font-size: 22rpx; font-weight: 600; color: #1A1A1A; line-height: 1.4; }
.trial-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.trial-points { font-size: 22rpx; font-weight: 800; color: #F59E0B; }
.trial-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #F3EDE5;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FFFFFF;
}
.trial-check.done { background: #34D399; border-color: #34D399; animation: checkPop 0.3s ease; }

/* ===== 宠物属性 ===== */
.pet-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.pet-emoji-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFEDD5;
}
.pet-emoji { font-size: 100rpx; }
.pet-stage-label { font-size: 24rpx; font-weight: 700; color: #A88B6A; }

.pet-switcher { width: 100%; }
.switcher-label {
  font-size: 20rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 8rpx;
}
.switcher-row { display: flex; gap: 10rpx; flex-wrap: wrap; }
.switcher-pet {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid #E2E8F0;
  background: #F8FAFC;
}
.switcher-pet:active { transform: scale(0.95); }
.switcher-icon { font-size: 28rpx; }
.switcher-name { font-size: 20rpx; font-weight: 600; color: #1E293B; }
.adopt-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 100%;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  background: #FFF6F0;
  border: 2rpx dashed #FFB088;
  border-radius: 18rpx;
}
.adopt-link:active { transform: scale(0.97); background: #FFEDD5; }
.adopt-link-text { font-size: 22rpx; font-weight: 700; color: #FF8A65; }
.adopt-link-arrow { font-size: 26rpx; font-weight: 800; color: #FF8A65; }

.pet-grow-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.pet-grow-label { font-size: 22rpx; color: #8A8178; }
.pet-grow-num { font-size: 24rpx; font-weight: 800; color: #1A1A1A; }
.pet-track {
  width: 100%;
  height: 14rpx;
  background: #F3EDE5;
  border-radius: 7rpx;
  overflow: hidden;
}
.pet-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.attrs { width: 100%; display: flex; flex-direction: column; gap: 14rpx; }
.attr-row { display: flex; align-items: center; gap: 12rpx; }
.attr-label { width: 60rpx; font-size: 22rpx; color: #8A8178; font-weight: 600; }
.attr-track {
  flex: 1;
  height: 14rpx;
  background: #F3EDE5;
  border-radius: 7rpx;
  overflow: hidden;
}
.attr-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.attr-val {
  width: 48rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 800;
  color: #1A1A1A;
}
.scales { width: 100%; display: flex; flex-direction: column; gap: 8rpx; }
.scales-label { font-size: 22rpx; font-weight: 700; color: #F59E0B; }
.scales-row { display: flex; flex-wrap: wrap; gap: 6rpx; }
.scale { font-size: 24rpx; color: #E5E7EB; }
.scale.on { color: #F59E0B; }

/* ===== 统计 pills ===== */
.stat-pills { display: flex; gap: 14rpx; }
.pill {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.pill:active { transform: scale(0.95); }
.pill-val { font-size: 30rpx; font-weight: 800; color: #1A1A1A; }
.pill-unit { font-size: 18rpx; font-weight: 500; }
.pill-label { font-size: 19rpx; color: #8A8178; }

/* ===== 技能树 ===== */
.skill-tree { display: flex; flex-direction: column; gap: 12rpx; }
.skill-node {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.skill-node:active { transform: scale(0.98); }
.skill-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #E5E7EB; }
.skill-node.unlocked .skill-dot { background: #34D399; }
.skill-node.lockable .skill-dot { background: #F59E0B; }
.skill-body { flex: 1; display: flex; flex-direction: column; }
.skill-name { font-size: 24rpx; font-weight: 700; color: #1A1A1A; }
.skill-desc { font-size: 19rpx; color: #8A8178; }
.skill-state { font-size: 19rpx; font-weight: 700; color: #8A8178; }
.skill-node.unlocked .skill-state { color: #34D399; }
.skill-node.lockable .skill-state { color: #F59E0B; }

/* ===== 属灵果实 ===== */
.fruit-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.fruit-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 12rpx 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.fruit-item-icon { font-size: 26rpx; }
.fruit-item-name { font-size: 22rpx; font-weight: 600; color: #1A1A1A; }

/* ===== 里程碑 ===== */
.milestones { display: flex; flex-direction: column; }
.mile-node {
  display: flex;
  gap: 14rpx;
  padding-bottom: 18rpx;
  position: relative;
}
.mile-node::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 18rpx;
  bottom: 0;
  width: 2rpx;
  background: #F3EDE5;
}
.mile-node:last-child::before { display: none; }
.mile-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  background: #E5E7EB;
  z-index: 1;
}
.mile-node.reached .mile-dot { background: #34D399; }
.mile-body { flex: 1; display: flex; flex-direction: column; }
.mile-label { font-size: 23rpx; font-weight: 700; color: #1A1A1A; }
.mile-node.reached .mile-label { color: #10B981; }
.mile-sub { font-size: 19rpx; color: #8A8178; margin-top: 2rpx; }
.mile-reward { font-size: 19rpx; color: #F59E0B; font-weight: 600; margin-top: 2rpx; }

/* ===== 签到照片回看 ===== */
.photo-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-cell {
  width: calc(33.33% - 10rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.photo-cell:active { transform: scale(0.96); }
.photo-cell-img {
  width: 100%;
  height: 120rpx;
  border-radius: 12rpx;
  display: block;
}
.photo-cell-name {
  display: block;
  font-size: 18rpx;
  color: #64748B;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
