.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 家庭头部 ===== */
.fam-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 8rpx 20rpx;
}
.fam-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.fam-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #1E293B;
}
.fam-count {
  font-size: 24rpx;
  color: #8A8178;
}
.fam-bond {
  font-size: 22rpx;
  color: #A8A29E;
}

/* ===== 今日概况 ===== */
.overview-card {
  background: linear-gradient(135deg, #FFE8DC, #FFF6F0);
  border-radius: 32rpx;
  padding: 30rpx 28rpx 26rpx;
  margin-bottom: 28rpx;
}
.ov-rate-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.ov-rate {
  font-size: 64rpx;
  font-weight: 800;
  color: #FF6D3B;
  line-height: 1;
}
.ov-rate-label { font-size: 24rpx; color: #8A8178; }
.ov-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.ov-stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 18rpx;
  padding: 14rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.ov-stat-val { font-size: 30rpx; font-weight: 700; color: #1E293B; }
.ov-stat-val.accent { color: #FF6D3B; }
.ov-unit { font-size: 20rpx; font-weight: 500; }
.ov-stat-label { font-size: 20rpx; color: #8A8178; }
.ov-actions { display: flex; gap: 16rpx; }
.ov-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #FF8A65, #FF6D3B);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ov-btn text { color: #FFFFFF; font-size: 26rpx; font-weight: 600; }
.ov-btn-ghost {
  background: #FFFFFF;
  border: 2rpx solid #FFB088;
}
.ov-btn-ghost text { color: #FF6D3B; }

/* ===== 分节标题 ===== */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 6rpx 8rpx 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}
.section-sub { font-size: 22rpx; color: #A8A29E; }

/* ===== 全家成员卡（一人一行） ===== */
.member-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 30rpx;
}
.fm-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid transparent;
  border-radius: 26rpx;
  padding: 20rpx 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.fm-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 3rpx solid #F5EFE8;
  overflow: hidden;
  flex-shrink: 0;
  background: #F5EFE8;
}
.fm-avatar-img { width: 100%; height: 100%; display: block; border-radius: 50%; }
.fm-avatar-emoji {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.fm-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.fm-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.fm-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  flex-shrink: 0;
}
.fm-me {
  font-size: 18rpx;
  color: #FF6D3B;
  background: #FFF3EC;
  border: 2rpx solid #FFB088;
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}
.fm-age {
  font-size: 20rpx;
  color: #A8A29E;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fm-progress-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fm-progress-track {
  flex: 1;
  height: 12rpx;
  background: #F1ECF6;
  border-radius: 6rpx;
  overflow: hidden;
}
.fm-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s ease;
}
.fm-rate {
  font-size: 20rpx;
  color: #64748B;
  flex-shrink: 0;
}
.fm-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.fm-pet {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF6F0;
  border-radius: 14rpx;
  padding: 6rpx 14rpx;
  max-width: 240rpx;
}
.fm-pet-icon { font-size: 26rpx; }
.fm-pet-name {
  font-size: 20rpx;
  color: #8A8178;
  max-width: 150rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fm-nums {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fm-streak { font-size: 20rpx; color: #EF4444; }
.fm-score { font-size: 20rpx; color: #64748B; }

/* ===== 家庭挑战 ===== */
.challenge-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(90deg, #FF8A65, #FFB088);
  border-radius: 32rpx;
  padding: 26rpx 30rpx;
  margin: 8rpx 0 30rpx;
}
.challenge-info { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.challenge-title { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }
.challenge-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.9); }
.challenge-progress {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 220rpx;
  flex-shrink: 0;
}
.challenge-track {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 7rpx;
  overflow: hidden;
}
.challenge-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 7rpx;
  transition: width 0.6s ease;
}
.challenge-num { font-size: 20rpx; color: #FFFFFF; text-align: right; }
.challenge-check {
  position: absolute;
  top: -14rpx;
  right: -6rpx;
  font-size: 44rpx;
}

/* ===== 结算（原结算页样式） ===== */
.period-tabs {
  display: flex;
  background: #F1F5F9;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}
.period-tab {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #64748B;
  transition: all 0.25s ease;
}
.period-tab:active { transform: scale(0.96); }
.period-tab.active {
  background: #FFFFFF;
  color: #F97316;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.settlement-card {
  background: linear-gradient(135deg, #FFF1E8, #FFE8DC);
  border-radius: 32rpx;
  padding: 34rpx 28rpx;
  margin-bottom: 24rpx;
}
.settlement-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}
.settlement-title { font-size: 34rpx; font-weight: 700; color: #F97316; }
.settlement-date { font-size: 24rpx; color: #8A8178; }

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 16rpx;
  margin-bottom: 10rpx;
}
.rank-item.highlight { background: rgba(255, 215, 0, 0.15); }
.rank-num {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.rank-num.gold { font-size: 40rpx; }
.rank-num.silver { font-size: 36rpx; }
.rank-num.bronze { font-size: 32rpx; }
.rank-emoji { font-size: 40rpx; }
.rank-name { flex: 1; font-size: 28rpx; font-weight: 500; color: #1E293B; white-space: nowrap; }
.rank-rate { font-size: 26rpx; font-weight: 600; color: #10B981; white-space: nowrap; }
.rank-extra { font-size: 22rpx; color: #64748B; white-space: nowrap; }
.rank-bonus {
  font-size: 20rpx;
  color: #DB2777;
  background: #FCE7F3;
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.rank-note {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ===== 通用卡 ===== */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; color: #1E293B; }

.reward-list { display: flex; flex-direction: column; gap: 12rpx; }
.reward-item { font-size: 26rpx; color: #475569; line-height: 1.6; }

.achievement-grid { display: flex; flex-wrap: wrap; }
.achievement-badge {
  width: 33.33%;
  text-align: center;
  padding: 20rpx 8rpx;
  opacity: 0.3;
  transition: opacity 0.5s ease;
}
.achievement-badge.earned { opacity: 1; }
.achievement-icon { font-size: 52rpx; display: block; }
.achievement-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #1E293B;
  margin-top: 6rpx;
}

.notice {
  padding: 20rpx 24rpx;
  background: #FFFBEB;
  border-radius: 20rpx;
  border-left: 6rpx solid #F59E0B;
}
.notice-text { font-size: 22rpx; color: #92400E; line-height: 1.6; }

/* ===== 今日签到照片墙 ===== */
.wall-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.wall-row { padding: 10rpx 0; }
.wall-row + .wall-row { border-top: 2rpx solid #F5F0EA; }
.wall-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.wall-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.wall-avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.wall-avatar-emoji { font-size: 24rpx; }
.wall-name { font-size: 24rpx; font-weight: 700; color: #1E293B; }
.wall-count { margin-left: auto; font-size: 20rpx; color: #94A3B8; }
.wall-photos { display: flex; flex-wrap: wrap; gap: 10rpx; }
.wall-photo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 14rpx;
  border: 2rpx solid #F0E8DE;
}
.wall-photo:active { transform: scale(0.95); }
