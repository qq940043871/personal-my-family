.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #475569;
  margin: 24rpx 0 14rpx;
}
.label:first-child { margin-top: 0; }

.emoji-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.emoji-chip {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #F8FAFC;
  border: 3rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.emoji-chip.active { border-color: #FF8A65; background: #FFF6F0; }
.emoji { font-size: 44rpx; }

.input {
  width: 100%;
  height: 92rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}
.placeholder { color: #94A3B8; }
.role-hint {
  display: block;
  font-size: 24rpx;
  color: #8A8178;
  margin-top: 12rpx;
}

.color-row { display: flex; flex-wrap: wrap; gap: 20rpx; }
.color-chip {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 6rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.color-chip.active { border-color: #1A1A1A; }
.color-check { font-size: 32rpx; color: #FFFFFF; font-weight: 800; }

.tip-card {
  background: #FFFBEB;
  border-radius: 24rpx;
  border-left: 8rpx solid #F59E0B;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.tip-title { display: block; font-size: 26rpx; font-weight: 700; color: #92400E; margin-bottom: 10rpx; }
.tip-text { display: block; font-size: 23rpx; color: #92400E; line-height: 1.7; }

.footer { display: flex; gap: 20rpx; }
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  padding: 26rpx 0;
}
.btn:active { transform: scale(0.97); }
.btn-danger {
  flex: 0 0 200rpx;
  background: #FEF2F2;
  border: 2rpx solid #FECACA;
}
.btn-danger-text { font-size: 30rpx; font-weight: 700; color: #EF4444; }
.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #FF8A65, #FF6B6B);
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}
.btn-primary-text { font-size: 32rpx; font-weight: 800; color: #FFFFFF; }
