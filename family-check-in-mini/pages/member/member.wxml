<view class="page">

  <!-- 头像 -->
  <view class="card">
    <text class="label">头像</text>
    <view class="emoji-row">
      <view
        wx:for="{{emojiPresets}}"
        wx:key="*this"
        class="emoji-chip {{form.emoji === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="pickEmoji"
      >
        <text class="emoji">{{item}}</text>
      </view>
    </view>

    <!-- 姓名 -->
    <text class="label">姓名</text>
    <input
      class="input"
      value="{{form.name}}"
      placeholder="请输入姓名"
      placeholder-class="placeholder"
      maxlength="12"
      bindinput="onNameInput"
    />

    <!-- 年龄 -->
    <text class="label">年龄</text>
    <input
      class="input"
      type="number"
      value="{{ageInput}}"
      placeholder="请输入年龄"
      placeholder-class="placeholder"
      maxlength="3"
      bindinput="onAgeInput"
    />
    <text class="role-hint">角色将按年龄自动设置为：{{roleHint}}</text>

    <!-- 主题色 -->
    <text class="label">主题色</text>
    <view class="color-row">
      <view
        wx:for="{{colorPresets}}"
        wx:key="*this"
        class="color-chip {{form.themeColor === item ? 'active' : ''}}"
        style="background: {{item}}"
        data-value="{{item}}"
        bindtap="pickColor"
      >
        <text wx:if="{{form.themeColor === item}}" class="color-check">✓</text>
      </view>
    </view>

    <!-- 宠物名 -->
    <text class="label">宠物名字</text>
    <input
      class="input"
      value="{{form.petName}}"
      placeholder="给小伙伴起个名字"
      placeholder-class="placeholder"
      maxlength="10"
      bindinput="onPetNameInput"
    />
  </view>

  <!-- 年龄差异说明 -->
  <view class="tip-card">
    <text class="tip-title">💡 年龄决定成长体系</text>
    <text class="tip-text">≤4 岁：3 阶段快速成长，用 ⭐ 代替积分，无连签惩罚</text>
    <text class="tip-text">5-54 岁：标准 5 阶段，参与家庭排名</text>
    <text class="tip-text">≥55 岁：慢成长，用「恩典值」，不参与排名，签到推送经文</text>
  </view>

  <!-- 操作 -->
  <view class="footer">
    <view wx:if="{{isEdit}}" class="btn btn-danger" bindtap="onDelete">
      <text class="btn-danger-text">删除</text>
    </view>
    <view class="btn btn-primary" bindtap="onSave">
      <text class="btn-primary-text">保存</text>
    </view>
  </view>
</view>
